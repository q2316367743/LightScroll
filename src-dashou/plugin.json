{
  "$schema": "../node_modules/@dashou/cli/schema/plugin-1.json",
  "schemaVersion": 1,
  "id": "com.dashou.lightscroll",
  "name": "轻卷 LightScroll",
  "version": "1.1.0",
  "description": "PDF 工具箱：阅读、水印（图层/防删除）、加密解密、页面管理、合并、转图片、压缩。",
  "author": { "name": "云中江树" },
  "homepage": "https://github.com/yzfly/lightscroll",
  "license": "MIT",
  "icon": "assets/icon.png",
  "core": "core.mjs",
  "activation": "onCommand",
  "resident": false,
  "csp": "worker-src 'self' plugin: blob:; img-src 'self' plugin: data: blob:; font-src 'self' plugin: data: blob:",
  "windows": [
    {
      "label": "main",
      "title": "轻卷 LightScroll",
      "url": "ui/index.html",
      "width": 1200,
      "height": 800,
      "minWidth": 920,
      "minHeight": 620,
      "center": true,
      "resizable": true,
      "backgroundColor": "#f6f8fb"
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "轻卷 LightScroll",
      "description": "PDF 工具箱：阅读 · 水印 · 页面管理 · 合并 · 转图片 · 压缩 · 加解密",
      "keywords": [
        "lightscroll",
        "轻卷",
        "pdf",
        "pdf阅读",
        "pdf水印",
        "加水印",
        "pdf压缩",
        "压缩pdf",
        "pdf合并",
        "合并pdf",
        "pdf转图片",
        "pdf加密",
        "pdf解密",
        "pdf页面管理"
      ],
      "mode": "window",
      "window": "main"
    },
    {
      "id": "open-files",
      "title": "用轻卷打开这些 PDF",
      "description": "把选中的 PDF 交给轻卷阅读或处理",
      "match": {
        "type": "files",
        "fileType": "file",
        "extensions": ["pdf"]
      },
      "mode": "window",
      "window": "main"
    }
  ],
  "capabilities": [
    {
      "identifier": "main-ui",
      "targets": ["main"],
      "permissions": [
        "core:event:allow-listen",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen"
      ]
    },
    {
      "identifier": "core-base",
      "targets": ["core"],
      "permissions": ["dialog:allow-open", "log:allow-log"]
    }
  ],
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  }
}
